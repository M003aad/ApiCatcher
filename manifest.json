{
  "manifest_version": 3,
  "name": "ApiCatcher",
  "version": "1.0.0",
  "description": "Inspect JSON Fetch and XMLHttpRequest responses directly in the current page.",
  "icons": {
    "16": "icons/16.16.png",
    "32": "icons/32.32.png",
    "48": "icons/48.48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Toggle ApiCatcher",
    "default_icon": {
      "16": "icons/16.16.png",
      "32": "icons/32.32.png",
      "48": "icons/48.48.png",
      "128": "icons/128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
